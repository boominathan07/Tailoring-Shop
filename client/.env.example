# Backend API Root URL
# When deployed on Vercel with the /api proxy rewrite, set to /api or leave unset (defaults to /api in production).
# In local development, if left unset, defaults to http://localhost:5000/api.
# If using a direct backend domain (e.g., custom shared domain): provide https://api.yourdomain.com/api.
VITE_API_URL=/api

# Optional: Real-time Socket.IO Server URL
# If omitted in production, Socket.IO connection is gracefully skipped to avoid proxy errors.
# In local development, defaults to http://localhost:5000.
# VITE_SOCKET_URL=https://tailoring-shop-6d03.onrender.com
